@startuml 04-ath-statemachine
title AthStateMachine — Run-Ablauf (IST, 12 States)

skinparam shadowing false
skinparam state {
  BackgroundColor<<hot>>      #FFF0C2
  BackgroundColor<<recovery>> #FFE0E0
  BackgroundColor<<terminal>> #E8E8E8
  BackgroundColor<<io>>       #E3F2FD
}
hide empty description

[*] --> Starting : StateMasterOn.Enter()\n-> Init()

state "StateAthStarting" as Starting <<io>> {
  Starting : Chat: MessageStarting()
  Starting : ---
  Starting : **RTM = false**
  Starting : CurrentLobby.RoundTime = 86400
  Starting : delay 2500 -> UpdateServerPlaylist -> delay 500
  Starting : Countdown 5s -> /fs
  Starting : ---
  Starting : **RTM = true** (bis 3 Versuche)
  Starting : DrawRandomLevelAsync() -> StartNewPlaylist()
  Starting : Countdown 5s -> /fs 0
}

state "StateAthLoadingLevel" as Loading <<io>> {
  Loading : RoundOverText = ATH-Header + letzter Level-Status
  Loading : wartet auf RacingApi.LevelLoaded
}

state "StateAthWaitingForLevelData" as Processing {
  Processing : validiert LevelApi.CurrentLevel
  Processing : null? -> broken? -> duplicate?
}

state "StateAthWaitingForReplacementLevel" as Broken <<recovery>> {
  Broken : Chat: MessageBrokenLevel()
  Broken : DrawRandomLevelAsync()
  Broken : ReplaceLevelInCurrentPlaylist()
  Broken : /fs restart
}

state "StateAthWaitingForExtraLevel" as Duplicate <<recovery>> {
  Duplicate : ConsecutiveDuplicateCount++
  Duplicate : DrawRandomLevelAsync()
  Duplicate : AddLevelToCurrentPlaylist()
  Duplicate : /fs next
}

state "StateAthWaitingForFirstRun" as FirstTime {
  FirstTime : Ctx.InitializingNewLevel(LevelApi.CurrentLevel)
  FirstTime :   -> new Level(), Levels.Add(), Level.Start()
  FirstTime : SetServerMessage(paused = true)
}

state "StateAthWaitingForFinish" as OnARun <<hot>> {
  OnARun : **Enter()** Level.AddTimeStamp()  <b>[Uhr läuft]</b>
  OnARun : **Exit()**  Level.AddTimeStamp()  <b>[Uhr stoppt]</b>
  OnARun : Chat: MessageOnARun()
  OnARun : Tick: SetServerMessage(false) + Low-Time-Warnung
}

state "StateAthWaitingForNextRun" as Pausing {
  Pausing : Medal-Progress-Text (einmalig)
  Pausing : Ctx.ResetRetries()
  Pausing : SetServerMessage(paused = true)
}

state "StateAthWaitingForRespawn" as WaitRespawn {
  WaitRespawn : Level.Stop()
  WaitRespawn : Popup "Author time claimed!"
  WaitRespawn : Chat: MessageAuthorMedalClaimed()
}

state "StateAthSkippingLevel" as Evaluate {
  Evaluate : bestimmt Skip-Typ (siehe Diagramm 07)
  Evaluate : Level.Skipped = true
  Evaluate : Level.Stop()
}

state "StateAthLevelSummary" as Summary {
  Summary : Chat: MessageLevelSummary()
}

state "StateAthStopping" as Stopping <<terminal>> {
  Stopping : ClearMedalText()
  Stopping : **InvokeFinish()**  -> Master schaltet auf Off
  Stopping : CurrentLevel.Stop()
  Stopping : Chat: MessageEnd()
  Stopping : optional: Playlist als ATH-RUN-... speichern
}

' ---------- Startphase ----------
Starting --> Loading : Execute() fertig
Starting --> Loading : OnRoundEnded()

' ---------- Ladephase ----------
Loading --> Processing : OnLevelLoaded()\n[!IsTimeOver && (RTM || Levels < Playlist)]
Loading --> Stopping  : OnLevelLoaded()\n[IsTimeOver || Playlist erschöpft]

' ---------- Validierung ----------
Processing --> Processing : LevelApi.CurrentLevel == null\n(delay 100 ms, Selbst-Retry)
Processing --> Broken     : Playlist[idx].UID != geladene UID
Processing --> Duplicate  : RTM && Levels.Contains(level)
Processing --> FirstTime  : Level ok
Processing --> Stopping   : Exception

Broken    --> Processing : OnLevelLoaded()
Duplicate --> Processing : OnLevelLoaded()
Duplicate --> Stopping   : ConsecutiveDuplicateCount >= 3

' ---------- Fahren ----------
FirstTime --> OnARun : OnRoundStarted()\n(+ fire&forget AddLevelAsync)

OnARun --> OnARun      : OnRoundStarted()\nAttempt++ (Reset)
OnARun --> Pausing     : OnCrossedFinishLine()\n[kein AT]
OnARun --> WaitRespawn : OnCrossedFinishLine()\n[Status == AUTHOR]
OnARun --> Pausing     : OnCrossedFinishLine()\n[CurrentResult == null]
OnARun --> Evaluate    : OnRoundEnded()
OnARun --> Stopping    : OnAthTimerTick()\n[IsTimeOver]

Pausing --> OnARun   : OnRoundStarted()
Pausing --> OnARun   : OnPhotoModeEntered()
Pausing --> Evaluate : OnRoundEnded()

WaitRespawn --> WaitRespawn : OnPlayerSpawned()\n-> /fs
WaitRespawn --> Summary     : OnRoundEnded()

Evaluate --> Summary : immer
Summary  --> Loading : immer

Stopping --> [*]

note right of OnARun
  <b>Uhr-Mechanik</b>
  Die Run-Zeit läuft ausschließlich
  in StateAthWaitingForFinish. Enter/Exit setzen
  Timestamp-Paare in Level.TimeStamps;
  GetPlayDuration() summiert die Paare.
  Ziel-/Pausenbildschirm zählt nicht.
end note

note left of Duplicate
  ConsecutiveDuplicateCount wird
  <b>nie zurückgesetzt</b> — der Zähler
  ist kumulativ über den ganzen Run,
  nicht "consecutive".
end note

note right of Broken
  Ersetzt wird die UID von
  Ctx.CurrentLevel — das ist das
  <b>vorherige</b> Level, nicht das
  gerade als broken erkannte.
end note

@enduml
