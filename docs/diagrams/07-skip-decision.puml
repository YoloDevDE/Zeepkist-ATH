@startuml 07-skip-decision
title Aktivität — Skip-Klassifikation in StateAthEvaluateSkip (IST)

skinparam shadowing false

start

:Rundenende erkannt\n(OnRoundEnded);

if (CurrentLevel.LevelBroken?) then (ja)
  #FFE0E0:**Broken-Skip**\nWarnung "Spent time refunded"\nStatus = BROKEN;
  note right
    Kein Penalty.
    TimeWasted = 0.
    GetTotalLevelPlayDuration()
    filtert broken Levels heraus
    -> Spielzeit wird erstattet.
  end note
else (nein)
  if (GoldMedalAcquired?\n(Status GOLD oder AUTHOR)) then (ja)
    #FFF3C4:**Gold-Skip**\ngoldenes Popup\nStatus = GOLD bzw. AUTHOR;
    note right
      Kein Penalty.
      AUTHOR erreicht diesen Zweig
      nur über OnRoundEnded aus
      StateAthPausing.
    end note
  else (nein)
    if (AvaiableFreeSkips > 0?) then (ja)
      #E3F2FD:**Free-Skip**\nAvaiableFreeSkips--\nFreeSkipped = true\nStatus = FREE;
      note right
        Startwert: 1, hardcodiert.
        Nicht konfigurierbar,
        wird nie nachgefüllt.
      end note
    else (nein)
      if (IsTimeRunningLow?) then (ja)
        #4A4A4A:**Fatal-Skip**\n"Well.. I tried to warn you"\nStatus = FAILED;
        note right
          <b>Fehlerhafte Bedingung:</b>
          IsTimeRunningLow =
            Restzeit <= PenaltyTime * Penalties

          Mit 0 Penalties: Schwelle 0
          Mit 3 Penalties: Schwelle 15 min
          -> Schwelle wächst mit
             der Penalty-Anzahl.

          Gemeint war vermutlich
          IsTimeAfterSkipRunningLow.

          Effekt ist derselbe wie
          Penalty-Skip — nur der Text
          unterscheidet sich.
        end note
      else (nein)
        #FFCDD2:**Penalty-Skip**\nFehler-Popup\nStatus = FAILED;
        note right
          Penalties++ (abgeleitet)
          -> GetAccumulatedPenaltyTime()
             += PenaltyTime (default 5 min)
          -> Restzeit sinkt sofort
        end note
      endif
    endif
  endif
endif

:CurrentLevel.Skipped = true;
:CurrentLevel.Stop()\n(Uhr endgültig anhalten);
:-> StateAthLevelSummary;

stop

@enduml
