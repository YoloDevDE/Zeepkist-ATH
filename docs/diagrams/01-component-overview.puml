@startuml 01-component-overview
title Author Time Hunting 2.0.0 — Komponentenübersicht (IST)

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

package "Zeepkist / BepInEx (extern)" #F2F2F2 {
  [BepInEx\nBaseUnityPlugin] as BepInEx
  [HarmonyX] as Harmony
  [ZeepSDK] as SDK
  [Assembly-CSharp\n(Spielcode)] as Game
}

package "AuthorTimeHunting.dll" {

  package "Entry" #EAF4FF {
    [Plugin\n(BaseUnityPlugin)] as Plugin
    [PluginConfig\n6 ConfigEntries] as Config
  }

  package "Commands" #EAFFEA {
    [CommandStart\n/ath start] as CStart
    [CommandStop\n/ath stop] as CStop
    [CommandRestart\n/ath restart] as CRestart
    [CommandSkipBroken\n/ath broken] as CBroken
  }

  package "States" #FFF4E0 {
    [MasterStateMachine\n(Off / On)] as MSM
    [AthStateMachine\n(MonoBehaviour, 12 States)] as ASM
    [AthCtx\n(Run-Kontext + Stats + Views)] as Ctx
  }

  package "Service" #F4EAFF {
    [PlaylistService\n(Rate-Limit-Queue)] as PS
    [RandomLevelService\n(Draw + Dedupe)] as RLS
    [GraphQLService\n(zRtm Query)] as GQL
    [LocalLevelCacheService\n(.zeeplist Fallback)] as LLC
    [ChatMessageService] as CMS
    [UIService  <<leer>>] as UIS
  }

  package "Entities" #E8F8F5 {
    [Level] as Level
    [LevelItem] as LevelItem
    [Root / ZRtm / Node\n(GraphQL DTOs)] as DTO
  }

  package "Patches" #FFEAEA {
    [OnlineGameplayUIPatch\n(Update Postfix)] as Patch
  }

  package "Util" #F7F7F7 {
    [MedalTextHelper] as MTH
    [Message.Builder] as Msg
    [Messenger] as Mngr
    [Logger] as Log
    [ColorDefinitions\nTimeFormatter\nTimeSpanExtensions\nStringUtils] as Fmt
    [ServerMessage  <<toter Code>>] as SrvMsg
    [EntityPresenter  <<toter Code>>] as EP
  }
}

cloud "graphql.zeepki.st" as Cloud
database "%APPDATA%\\Zeepkist\\Playlists\n*.zeeplist" as Disk

Plugin --> Config
Plugin --> MSM
Plugin --> Harmony : PatchAll()
Plugin --> SDK : RegisterLocalChatCommand
Plugin ..> BepInEx

CStart ..> MSM : static event
CStop ..> MSM : static event
CRestart ..> MSM : static event
CBroken ..> ASM : static event

MSM --> ASM : SubStateMachine
ASM --> Ctx
ASM --> SDK : RacingApi / PhotoModeApi
Ctx --> Level
Ctx --> Msg

ASM --> PS
ASM --> RLS
ASM --> CMS
ASM --> MTH
PS --> SDK : MultiplayerApi / ChatApi
PS --> Game : ZeepkistNetwork.CurrentLobby
RLS --> GQL
RLS --> LLC
RLS --> LevelItem
GQL --> DTO
GQL --> Cloud : HTTPS POST
LLC --> Disk
LLC --> SDK : PlaylistApi
CMS --> Game : SendCustomChatMessage

Patch --> Game : OnlineGameplayUI.Update
Patch --> MTH
Patch ..> Harmony

note right of SrvMsg
  405 LoC Builder-DSL,
  wird nirgends instanziiert
end note

note right of UIS
  Leerer Singleton
end note

@enduml
