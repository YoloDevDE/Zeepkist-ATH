@startuml 05-sequence-run-start
title Sequenz — Run-Start "/ath start" im RTM-Modus (IST)

skinparam shadowing false
skinparam responseMessageBelowArrow true
autonumber "<b>[00]"

actor Player
participant "ChatCommandApi\n(ZeepSDK)" as SDK
participant "CommandStart" as Cmd
participant "MasterStateMachine" as MSM
participant "StateMasterOff" as Off
participant "StateMasterOn" as On
participant "AthStateMachine\n(MonoBehaviour)" as ASM
participant "StateAthStarting" as Start
participant "RandomLevelService" as RLS
participant "GraphQLService" as GQL
participant "PlaylistService" as PS
participant "OnlineGameplayUI" as UI

Player -> SDK : "/ath start"
SDK -> Cmd : Handle("")
Cmd -> Off : CommandTrigger (static event)
Off -> MSM : TransitionTo(new StateMasterOn)

MSM -> Off : Exit()  — Commands abmelden
note right of On
  ctor: CreateAthStateMachine()
  GameObject "AthStateMachine"
  + HideAndDontSave
  + DontDestroyOnLoad
end note
MSM -> On : Enter()
activate On
On -> UI : TimeLeftText.enabled = false\nRoundOverText.enabled = true
On -> ASM : StartTimer()
ASM -> ASM : SubscribeEvents()\n(RacingApi + PhotoModeApi)
On --> Player : Messenger "started"
deactivate On

MSM -> ASM : SubStateMachine.Init()
ASM -> Start : Enter() / Execute()
activate Start

Start -> Player : Chat: MessageStarting()

loop max. 3 Versuche
  Start -> RLS : DrawRandomLevelAsync()
  activate RLS
  RLS -> GQL : GetRandomLevelAsync(100, maxAT=180)
  activate GQL
  GQL -> GQL : POST zRtm-Query\nan graphql.zeepki.st
  GQL --> RLS : List<LevelItem>  (oder null)
  deactivate GQL
  alt GraphQL leer / Fehler
    RLS -> RLS : FetchFromLocalPlaylists()\n(LocalLevelCacheService, .zeeplist)
  end
  RLS --> Start : OnlineZeeplevel
  deactivate RLS
  Start -> PS : StartNewPlaylist(level)
  PS -> PS : Playlist.Clear() + Add(level)
  PS -> PS : QueueServerPlaylistUpdate()\n(5s Rate-Limit-Queue)
end

Start -> UI : RunCountdown() — 5x RoundOverText\n(IsCountdownActive = true)
note right of UI
  OnlineGameplayUIPatch hält
  EndRoundBuffer aktiv und
  Alpha = 1, solange
  IsCountdownActive true ist.
end note

Start -> PS : SkipToFirstLevel()
PS -> SDK : ChatApi.SendMessage("/fs 0")
Start -> ASM : TransitionTo(StateAthLoadingLevel)
deactivate Start

... Spiel lädt Level ...

ASM -> ASM : RacingApi.LevelLoaded\n-> StateAthLoadingLevel.OnLevelLoaded()

@enduml
