<Project Sdk="Microsoft.NET.Sdk">

    <!-- General Project Properties -->
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <Description>Zeepkist Plugin to help with Author Time Hunting</Description>
        <Version>2.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <PackageId>Author Time Hunting</PackageId>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <Authors>Hi Im Yolo</Authors>
        <Title>Author Time Hunting</Title>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <!-- Package References -->
    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.*"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
        <PackageReference Include="GraphQL.Client" Version="6.1.0"/>
        <PackageReference Include="GraphQL.Client.Serializer.Newtonsoft" Version="6.1.0"/>
        <PackageReference Include="Zeepkist.GameLibs" Version="17.32.1912" PrivateAssets="all"/>
        <PackageReference Include="ZeepSDK" Version="2.6.1" PrivateAssets="all" />
        <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all"/> <!-- Fody package -->
        <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all"/> <!-- Costura package -->
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Microsoft.CSharp"/>
    </ItemGroup>

    <!--
        Deploy-Ziel. Überschreibbar per `dotnet build -p:ZeepkistDir=...`
        oder per Umgebungsvariable ZeepkistDir, damit der Build auf anderen
        Maschinen und im CI nicht bricht.
    -->
    <PropertyGroup>
        <ZeepkistDir Condition="'$(ZeepkistDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Zeepkist</ZeepkistDir>
        <ZeepkistPluginDir>$(ZeepkistDir)\BepInEx\plugins\Sideloaded\Plugins</ZeepkistPluginDir>
    </PropertyGroup>

    <Target Name="DeployToZeepkist" AfterTargets="PostBuildEvent" Condition="Exists('$(ZeepkistDir)')">
        <PropertyGroup>
            <_AthDeployDir>$(ZeepkistPluginDir)\$(ProjectName)</_AthDeployDir>
            <_AthZipPath>$(ZeepkistPluginDir)\$(ProjectName)-$(Version).zip</_AthZipPath>
        </PropertyGroup>

        <RemoveDir Directories="$(_AthDeployDir)"/>
        <MakeDir Directories="$(_AthDeployDir)"/>

        <Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFiles="$(_AthDeployDir)\$(ProjectName)-$(Version).dll"/>

        <Delete Files="$(_AthZipPath)"/>
        <ZipDirectory SourceDirectory="$(_AthDeployDir)" DestinationFile="$(_AthZipPath)" Overwrite="true"/>

        <Message Importance="high" Text="ATH: deployed $(ProjectName)-$(Version).dll -> $(_AthDeployDir)"/>
    </Target>

    <Target Name="_AthDeploySkipped" AfterTargets="PostBuildEvent" Condition="!Exists('$(ZeepkistDir)')">
        <Message Importance="high" Text="ATH: Zeepkist nicht gefunden unter '$(ZeepkistDir)' — Deploy übersprungen. Override: -p:ZeepkistDir=&lt;pfad&gt;"/>
    </Target>
</Project>
