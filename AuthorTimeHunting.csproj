<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Zeepkist Plugin to help with Author Time Hunting</Description>
        <Title>Author Time Hunting</Title>
        <PackageId>Author Time Hunting</PackageId>
    </PropertyGroup>

    <!--
        The SDK globs **/*.cs from the project directory, which would pull the test
        project's sources into the plugin assembly.
    -->
    <ItemGroup>
        <Compile Remove="tests\**\*.cs"/>
        <None Remove="tests\**"/>
    </ItemGroup>

    <!-- The mod's own picture, for the loading screen. Embedded so there is nothing to install. -->
    <ItemGroup>
        <EmbeddedResource Include="assets\thumbnail\ATH_16-9.png" LogicalName="AuthorTimeHunting.Thumbnail.png"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GraphQL.Client" Version="6.1.0"/>
        <PackageReference Include="GraphQL.Client.Serializer.Newtonsoft" Version="6.1.0"/>
        <PackageReference Include="Zeepkist.GameLibs" Version="17.32.1912" PrivateAssets="all"/>
        <PackageReference Include="ZeepSDK" Version="2.6.2" PrivateAssets="all"/>

        <!-- Costura embeds the dependencies above into the plugin DLL. -->
        <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all"/>
        <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all"/>
    </ItemGroup>

    <!--
        On net472 ReadOnlySpan<T> exists both in mscorlib and in System.Memory, which
        arrives transitively through the GraphQL client. Anything touching ZeepSDK's Imui
        text API then fails to compile with CS0433. Hiding System.Memory behind an alias
        leaves exactly one visible ReadOnlySpan<T> - the one from mscorlib, which is what
        the game's own assemblies were built against. Same trick GTR uses.
    -->
    <Target Name="AliasSystemMemory" AfterTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <ReferencePath Condition="'%(FileName)' == 'System.Memory'">
                <Aliases>MemoryAlias</Aliases>
            </ReferencePath>
        </ItemGroup>
    </Target>

</Project>
